/*
========================================================================================
    Nextflow config file for running nf-test tests
========================================================================================
    Settings applied to every nf-test run (see nf-test.config).
    Test inputs come from the `test` profile (conf/test.config).
*/

params {
    // Process tests publish into the nf-test output directory
    outdir = "${launchDir}/output"
}

// Keep test logs short: no automatic retries
process {
    maxRetries    = 0
    errorStrategy = 'terminate'
}

// Fixes S3 access issues on self-hosted runners
aws.client.anonymous = true
