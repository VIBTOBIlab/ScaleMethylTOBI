nextflow_process {

    name "Test Process REGULARIZE_SAMPLES_CSV"
    script "../main.nf"
    process "REGULARIZE_SAMPLES_CSV"
    tag "modules"
    tag "modules_local"
    tag "regularize_samples_csv"

    test("Fills in defaults and expands barcode ranges") {
        when {
            process {
                """
                input[0] = file("${projectDir}/tests/data/samples.csv")
                input[1] = "lib.json"
                input[2] = file("${projectDir}/references")
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }

    test("Rejects invalid sample names") {
        when {
            process {
                """
                def csv = file("${workDir}/bad_samples.csv")
                csv.text = "sample,barcodes,libName\\nSample_A,1A01-1A03,ScaleMethyl\\n"
                input[0] = csv
                input[1] = "lib.json"
                input[2] = file("${projectDir}/references")
                """
            }
        }
        then {
            assertAll(
                { assert process.failed },
                { assert process.errorReport.contains("Name should only contain") }
            )
        }
    }
}
