nextflow_process {

    name "Test Process CREATE_WINDOWS_BED"
    script "../main.nf"
    process "CREATE_WINDOWS_BED"
    tag "modules"
    tag "modules_local"
    tag "create_windows_bed"

    test("10 kb CG bins without blacklist") {
        when {
            process {
                """
                def sizes = file("${workDir}/chrom.sizes")
                sizes.text = "chr1\\t40000\\nchr2\\t30000\\n"
                input[0] = sizes
                input[1] = []
                input[2] = 10000
                input[3] = 200
                input[4] = 'CG'
                """
            }
        }
        then {
            assertAll(
                { assert process.success },
                { assert snapshot(process.out).match() }
            )
        }
    }
}
