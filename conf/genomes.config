/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Pre-built reference genomes
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Genomes selected by name with --genome. Each genome is a .tgz archive published by
    ScaleBio with the bwa-meth index, the annotation files and a genome.json that lists them.
    The archive is downloaded and unpacked by the pipeline, in the work directory of the run.

    Use --genomes_base to read the archives from a mirror (e.g. a copy on your cluster).
----------------------------------------------------------------------------------------
*/

params.genomes = [
    'hg38' : [
        description : 'Human GRCh38 (hg38)',
        archive     : "${params.genomes_base}/grch38-bwa.tgz",
    ],
    'mm39' : [
        description : 'Mouse GRCm39 (mm39)',
        archive     : "${params.genomes_base}/mm39-bwa.tgz",
    ],
]
