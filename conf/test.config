/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Nextflow config file for running minimal tests
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Defines input files and everything required to run a fast and simple pipeline test.
    The tiny synthetic dataset is stored in tests/data (see tests/README.md) and the
    whole workflow runs in a few minutes on a laptop.

    Use as follows:
        nextflow run VIBTOBIlab/scalemethyltobi -profile test,<docker/singularity> --outdir <OUTDIR>

----------------------------------------------------------------------------------------
*/

process {
    // Limit resources so that the test fits on a laptop or a GitHub runner
    resourceLimits = [
        cpus: 2,
        memory: '6.GB',
        time: '1.h'
    ]
}

params {
    config_profile_name        = 'Test profile'
    config_profile_description = 'Minimal test dataset to check pipeline function'

    // Input data
    input     = "${projectDir}/tests/data/samples.csv"
    fastq_dir = "${projectDir}/tests/data/fastq"
    genome    = "${projectDir}/tests/data/genome/genome.json"

    // The synthetic cells have ~300 reads each
    min_uniq_count = 50

    // The synthetic chromosomes are 30-40 kb
    window_tile_size_cg = 10000
    window_tile_size_ch = 20000
}
