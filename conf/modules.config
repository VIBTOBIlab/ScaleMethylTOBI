/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Config file for defining DSL2 per module options and publishing paths
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Available keys to override module options:
        ext.args   = Additional arguments appended to command in module.
        ext.args2  = Second set of arguments appended to command in module (multi-tool modules).
        ext.args3  = Third set of arguments appended to command in module (multi-tool modules).
        ext.prefix = File name prefix for output files.
----------------------------------------------------------------------------------------
*/

process {

    // Nothing is published unless configured below
    publishDir = [
        enabled: false
    ]

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Reference genome
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'CREATE_CHROM_SIZES|CREATE_WINDOWS_BED_.*' {
        publishDir = [
            path: { "${params.outdir}/samples/genome_bin_matrix" },
            mode: params.publish_dir_mode,
            pattern: '{chrom.sizes,*.bed}'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Read QC (cutadapt/fastqc), demultiplexing (bc_parser/) and trimming (cutadapt/)
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'FASTQC' {
        publishDir = [
            path: { "${params.outdir}/cutadapt" },
            mode: params.publish_dir_mode,
            pattern: 'fastqc/*.html'
        ]
    }

    withName: 'BC_PARSER' {
        // Each bc_parser job (library and fastq set) writes to its own directory, so that the published
        // metrics.json and barcode counts of the sequencing runs of a library do not overwrite each other
        ext.prefix = { "${meta.lib}.${meta.fastq_num}.demux" }
        publishDir = [
            [
                path: { "${params.outdir}/bc_parser" },
                mode: params.publish_dir_mode,
                pattern: '*.demux/*{txt,tsv,json}'
            ],
            [
                path: { "${params.outdir}/bc_parser" },
                mode: params.publish_dir_mode,
                pattern: '*.demux/*gz',
                enabled: params.save_demux_fastq
            ]
        ]
    }

    withName: 'MERGE_DEMUX' {
        publishDir = [
            path: { "${params.outdir}/bc_parser" },
            mode: params.publish_dir_mode,
            pattern: '*.metrics.json'
        ]
    }

    withName: 'CUTADAPT' {
        ext.args = '-a CTATCTCTTATA -A AGATCGGAAGAGC -U -10 -m20'
        publishDir = [
            [
                path: { "${params.outdir}/cutadapt/logs" },
                mode: params.publish_dir_mode,
                pattern: '*.{trim_stats.json,trim_log}'
            ],
            [
                path: { "${params.outdir}/cutadapt" },
                mode: params.publish_dir_mode,
                pattern: '*.fq.gz',
                enabled: params.save_trimmed
            ]
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Alignment and deduplication (bwameth/), methylation extraction (methylation_calls/)
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'BWAMETH_ALIGN' {
        publishDir = [
            [
                path: { "${params.outdir}/bwameth/alignments" },
                mode: params.publish_dir_mode,
                pattern: '*.bam',
                enabled: params.save_bam
            ],
            [
                path: { "${params.outdir}/bwameth/alignments/samtools_stats" },
                mode: params.publish_dir_mode,
                pattern: '*.flagstat.txt'
            ]
        ]
    }

    withName: 'SC_DEDUP' {
        ext.args = { "--duplicate-key ${params.dedup_key} --min-mapq ${params.min_mapq}" }
        publishDir = [
            [
                path: { "${params.outdir}/bwameth/deduplicated/logs" },
                mode: params.publish_dir_mode,
                pattern: '*.{dedup_stats,cell_stats,fragment_hist}.tsv'
            ],
            [
                path: { "${params.outdir}/bwameth/deduplicated" },
                mode: params.publish_dir_mode,
                pattern: '*.dedup.bam',
                enabled: params.save_dedup_bam
            ]
        ]
    }

    withName: 'MET_EXTRACT' {
        ext.args = { "--threshold ${(params.ch_reads_threshold as BigDecimal) / 100} --contexts ${params.skip_ch_context ? 'CG' : 'CG,CH'}" }
        publishDir = [
            [
                path: { "${params.outdir}/methylation_calls" },
                mode: params.publish_dir_mode,
                pattern: '*.cellInfo.txt'
            ],
            [
                path: { "${params.outdir}/methylation_calls/parquet" },
                mode: params.publish_dir_mode,
                pattern: '*.met_*.parquet',
                enabled: params.save_parquet
            ]
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Metrics (cell_metrics/, samples/<sample>.allCells.csv)
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'MERGE_STATS' {
        publishDir = [
            path: { "${params.outdir}/cell_metrics" },
            mode: params.publish_dir_mode,
            pattern: 'metrics_for_reporting/*',
            saveAs: { filename -> filename.tokenize('/').last() }
        ]
    }

    withName: 'GENERATE_METRICS' {
        ext.args = { "--top_cell_percentage ${params.top_cell_percentile} --min_cell_ratio ${params.min_cell_ratio} --min_reads ${params.min_uniq_count} --min_uniq_total ${params.min_uniq_total} --max_uniq_total ${params.max_uniq_total}" }
        publishDir = [
            [
                path: { "${params.outdir}/cell_metrics" },
                mode: params.publish_dir_mode,
                pattern: '*.tss_enrich.csv'
            ],
            [
                path: { "${params.outdir}/reports/samples" },
                mode: params.publish_dir_mode,
                pattern: '*/csv'
            ],
            [
                // Kept with the barcodes as cell names (samples/ has <sample>_<barcode>)
                path: { "${params.outdir}/cell_metrics" },
                mode: params.publish_dir_mode,
                pattern: '*.allCells.csv'
            ],
            [
                path: { "${params.outdir}/samples" },
                mode: params.publish_dir_mode,
                pattern: '*.allCells.csv',
                enabled: params.skip_cell_prefix
            ]
        ]
    }

    withName: 'PREFIX_CELL_NAMES' {
        publishDir = [
            [
                path: { "${params.outdir}/samples" },
                mode: params.publish_dir_mode,
                pattern: 'prefixed/*.allCells.csv',
                saveAs: { filename -> filename.tokenize('/').last() }
            ],
            [
                path: { "${params.outdir}/samples/genome_bin_matrix" },
                mode: params.publish_dir_mode,
                pattern: 'prefixed/*.barcodes.tsv',
                saveAs: { filename -> filename.tokenize('/').last() }
            ]
        ]
    }

    withName: 'COMBINED_GENERATE_METRICS' {
        publishDir = [
            [
                path: { "${params.outdir}/reports/libraries" },
                mode: params.publish_dir_mode,
                pattern: '*/*.csv'
            ],
            [
                path: { "${params.outdir}/reports/libraries" },
                mode: params.publish_dir_mode,
                pattern: '*/csv'
            ]
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Matrices and per-cell methylation coverage files (samples/: the layout read by Amethyst)
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'CREATE_MTX_CH' {
        ext.args = '--CH'
    }

    withName: 'MERGE_MTX_.*' {
        publishDir = [
            [
                path: { "${params.outdir}/samples/genome_bin_matrix" },
                mode: params.publish_dir_mode,
                pattern: '*.{mtx.gz,features.tsv}'
            ],
            [
                // With cell names <sample>_<barcode>, from PREFIX_CELL_NAMES
                path: { "${params.outdir}/samples/genome_bin_matrix" },
                mode: params.publish_dir_mode,
                pattern: '*.barcodes.tsv',
                enabled: params.skip_cell_prefix
            ]
        ]
    }

    withName: 'CREATE_ALLC' {
        publishDir = [
            path: { "${params.outdir}/samples/methylation_coverage/allc/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '{CG,CH}/*{.allc.tsv.gz,.tbi}'
        ]
    }

    withName: 'CREATE_BISMARK' {
        publishDir = [
            path: { "${params.outdir}/samples/methylation_coverage/cov/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '{CG,CH}/*.cov.gz'
        ]
    }

    withName: 'CREATE_AMETHYST' {
        // Cell names <sample>_<barcode>, as in samples/<sample>.allCells.csv
        ext.args = { params.skip_cell_prefix ? '' : "--cell_prefix ${meta.sample}" }
        publishDir = [
            path: { "${params.outdir}/samples/methylation_coverage/amethyst/${meta.sample}" },
            mode: params.publish_dir_mode,
            pattern: '*_cov.h5'
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        Reports (reports/)
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'GENERATE_SAMPLE_REPORT' {
        publishDir = [
            [
                path: { "${params.outdir}/reports/samples" },
                mode: params.publish_dir_mode,
                pattern: '*/*.html'
            ],
            [
                path: { "${params.outdir}/reports/samples" },
                mode: params.publish_dir_mode,
                pattern: '*/png'
            ],
            [
                path: { "${params.outdir}/reports/samples" },
                mode: params.publish_dir_mode,
                pattern: '*/csv/*.report_clusters.tsv'
            ],
            [
                path: { "${params.outdir}/cell_metrics" },
                mode: params.publish_dir_mode,
                pattern: '*.tss_enrich.csv'
            ]
        ]
    }

    withName: 'COMBINED_SAMPLE_REPORT' {
        publishDir = [
            [
                path: { "${params.outdir}/reports/libraries" },
                mode: params.publish_dir_mode,
                pattern: '*/*.html'
            ],
            [
                path: { "${params.outdir}/reports/libraries" },
                mode: params.publish_dir_mode,
                pattern: '*/png'
            ]
        ]
    }

    /*
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
        MultiQC
    ~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    */

    withName: 'MULTIQC' {
        ext.args = { params.multiqc_title ? "--title \"${params.multiqc_title}\"" : '' }
        publishDir = [
            path: { "${params.outdir}/multiqc" },
            mode: params.publish_dir_mode,
            pattern: 'multiqc_{report.html,data}'
        ]
    }
}
