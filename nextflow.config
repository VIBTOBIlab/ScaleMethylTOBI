/*
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    VIBTOBIlab/scalemethyltobi Nextflow config file
~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~~
    Default config options for all compute environments
----------------------------------------------------------------------------------------
*/

// Global default params, used in configs
params {

    // Input options
    input                      = null   // Samplesheet: samples, their Tn5 barcodes and the fastq files of the libraries; required
    lib_structure              = "lib.json" // Library structure definition; absolute path or relative to ${projectDir}/references/

    // Reference genome: either a pre-built genome by name, or your own genome.json
    genome                     = null   // Pre-built genome (conf/genomes.config): hg38 or mm39
    genome_json                = null   // Path to genome.json, for genomes not in conf/genomes.config
    genomes_base               = 'https://s3.us-east-2.amazonaws.com/scale.pub/genomes/methyl' // Location of the pre-built genome archives

    // Pre-processing options
    split_fastq                = true   // Split fastq files by sample and Tn5 well for increased parallelization
    skip_fastqc                = false  // Do not run FastQC
    adapters                   = null   // Adapter list for FastQC; default: references/SciMETv2_Adapters.tsv

    // Deduplication and methylation extraction options
    dedup_key                  = "Leftmost"
    min_mapq                   = 10
    skip_ch_context            = false  // Do not calculate CH methylation (reports, parquet files, matrices)
    ch_reads_threshold         = 50     // Discard reads with a percentage of methylated CH above this threshold

    // Cell-calling options
    top_cell_percentile        = 99     // Percentile of unique reads per cell used as 'robust max'
    min_cell_ratio             = 20     // Ratio between the unique reads of top cells and the cell threshold
    min_uniq_count             = 1000   // Minimum unique reads to consider a barcode as a potential cell
    min_uniq_total             = 1      // Minimum percentage of unique out of total reads
    max_uniq_total             = 100    // Maximum percentage of unique out of total reads
    skip_tss_enrich            = false  // Do not compute the per-cell TSS enrichment

    // Matrix generation options
    skip_window_matrix         = false  // Do not generate the matrices with the methylation signal per genome bin
    window_tile_size_cg        = 50000  // Bin size for the CG matrix; ignored when genomeTiles is set in genome.json
    window_tile_size_ch        = 100000 // Bin size for the CH matrix; ignored when genomeTilesCH is set in genome.json
    minimum_window_size        = 200    // Minimum bin size after removing blacklisted regions

    // Skipped steps and published intermediate files
    skip_cov                   = false  // Do not write the per-cell methylation coverage in Bismark .cov format
    skip_allc                  = false  // Do not write the per-cell methylation coverage in .allc format (ALLCools)
    skip_amethyst              = false  // Do not write the per-cell methylation coverage in Amethyst hdf5 format
    skip_cell_prefix           = false  // Keep the barcodes as cell names in samples/ (default: <sample>_<barcode>)
    save_parquet               = true   // Publish the methylation calls (parquet), needed to restart with --start_post_extraction
    save_demux_fastq           = false  // Publish the demultiplexed fastq files
    save_trimmed               = false  // Publish the adapter-trimmed fastq files
    save_bam                   = false  // Publish the BAM files with all aligned reads
    save_dedup_bam             = false  // Publish the BAM files with unique (deduplicated) reads

    // MultiQC options
    skip_multiqc               = false  // Do not run MultiQC
    multiqc_title              = null   // Title of the MultiQC report

    // Restart and merge options
    previous_outdir            = null   // Output directory of a previous run (for --reporting_only / --start_post_extraction)
    merge_runs                 = false  // Merge previous runs listed in the resultDir column of samples.csv
    start_post_extraction      = false  // Start after methylation extraction (requires the parquet files of a previous run)
    reporting_only             = false  // Only regenerate the metrics and reports
    bam1_dir                   = null   // alignments/bam directory of a previous run, merged with --bam2_dir
    bam2_dir                   = null   // alignments/bam directory of a previous run, merged with --bam1_dir
    save_merged_bam            = false  // Publish the merged BAM files

    // Boilerplate options
    outdir                       = "ScaleMethyl.out"
    publish_dir_mode             = 'copy'
    email                        = null
    email_on_fail                = null
    plaintext_email              = false
    monochrome_logs              = false
    help                         = false
    help_full                    = false
    show_hidden                  = false
    version                      = false
    trace_report_suffix          = java.time.LocalDateTime.now().format(java.time.format.DateTimeFormatter.ofPattern('yyyy-MM-dd_HH-mm-ss'))

    // Config options
    config_profile_name        = null
    config_profile_description = null

    custom_config_version      = 'master'
    custom_config_base         = "https://raw.githubusercontent.com/nf-core/configs/${params.custom_config_version}"
    config_profile_contact     = null
    config_profile_url         = null

    // Schema validation default options
    validate_params            = true
}

// Backwards compatibility for publishDir syntax
outputDir = params.outdir
workflow.output.mode = params.publish_dir_mode

// Load base.config by default for all pipelines
includeConfig 'conf/base.config'

// Pre-built reference genomes (--genome)
includeConfig 'conf/genomes.config'

profiles {
    debug {
        dumpHashes              = true
        process.beforeScript    = 'echo $HOSTNAME'
        cleanup                 = false
        nextflow.enable.configProcessNamesValidation = true
    }
    conda {
        conda.enabled           = true
        // All tools except bcl-convert (same software as the container)
        process.conda           = "${projectDir}/envs/scaleMethylTools.conda.yml"
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        conda.channels          = ['conda-forge', 'bioconda']
        apptainer.enabled       = false
    }
    mamba {
        conda.enabled           = true
        conda.useMamba          = true
        process.conda           = "${projectDir}/envs/scaleMethylTools.conda.yml"
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    docker {
        docker.enabled          = true
        conda.enabled           = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
        docker.runOptions       = '-u $(id -u):$(id -g)'
    }
    arm64 {
        process.arch            = 'arm64'
        // TODO https://github.com/nf-core/modules/issues/6694
        // For now if you're using arm64 you have to use wave for the sake of the maintainers
        // wave profile
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    emulate_amd64 {
        docker.runOptions       = '-u $(id -u):$(id -g) --platform=linux/amd64'
    }
    singularity {
        singularity.enabled     = true
        singularity.autoMounts  = true
        // Needed to run scanpy (numba cache) in the container
        singularity.runOptions  = '--no-mount tmp --env NUMBA_CACHE_DIR=/tmp/numba_cache --writable-tmpfs'
        conda.enabled           = false
        docker.enabled          = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    podman {
        podman.enabled          = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        shifter.enabled         = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    shifter {
        shifter.enabled         = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        charliecloud.enabled    = false
        apptainer.enabled       = false
    }
    charliecloud {
        charliecloud.enabled    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        apptainer.enabled       = false
    }
    apptainer {
        apptainer.enabled       = true
        apptainer.autoMounts    = true
        conda.enabled           = false
        docker.enabled          = false
        singularity.enabled     = false
        podman.enabled          = false
        shifter.enabled         = false
        charliecloud.enabled    = false
    }
    wave {
        apptainer.ociAutoPull   = true
        singularity.ociAutoPull = true
        wave.enabled            = true
        wave.freeze             = true
        wave.strategy           = 'conda,container'
    }
    gpu {
        docker.runOptions       = '-u $(id -u):$(id -g) --gpus all'
        apptainer.runOptions    = '--nv'
        singularity.runOptions  = '--nv'
    }
    test      { includeConfig 'conf/test.config'      }
}

// Load nf-core custom profiles from different institutions

// If params.custom_config_base is set AND either the NXF_OFFLINE environment variable is not set or params.custom_config_base is a local path, the nfcore_custom.config file from the specified base path is included.
// Load VIBTOBIlab/scalemethyltobi custom profiles from different institutions.
includeConfig params.custom_config_base && (!System.getenv('NXF_OFFLINE') || !params.custom_config_base.startsWith('http')) ? "${params.custom_config_base}/nfcore_custom.config" : "/dev/null"



// Set default registry for Apptainer, Docker, Podman, Charliecloud and Singularity independent of -profile
// Will not be used unless Apptainer / Docker / Podman / Charliecloud / Singularity are enabled
// Set to your registry if you have a mirror of containers
apptainer.registry    = 'quay.io'
docker.registry       = 'quay.io'
podman.registry       = 'quay.io'
singularity.registry  = 'quay.io'
charliecloud.registry = 'quay.io'



// Export these variables to prevent local Python/R libraries from conflicting with those in the container
// The JULIA depot path has been adjusted to a fixed path `/usr/local/share/julia` that needs to be used for packages in the container.
// See https://apeltzer.github.io/post/03-julia-lang-nextflow/ for details on that. Once we have a common agreement on where to keep Julia packages, this is adjustable.

env {
    PYTHONNOUSERSITE = 1
    R_PROFILE_USER   = "/.Rprofile"
    R_ENVIRON_USER   = "/.Renviron"
    JULIA_DEPOT_PATH = "/usr/local/share/julia"
    // scanpy (numba) needs a writable cache directory when the container runs as the user
    NUMBA_CACHE_DIR  = "/tmp/numba_cache"
}

// Set bash options
process.shell = [
    "bash",
    "-C",         // No clobber - prevent output redirection from overwriting files.
    "-e",         // Exit if a tool returns a non-zero status/exit code
    "-u",         // Treat unset variables and parameters as an error
    "-o",         // Returns the status of the last command to exit..
    "pipefail"    //   ..with a non-zero status or zero if all successfully execute
]

// Disable process selector warnings by default. Use debug profile to enable warnings.
nextflow.enable.configProcessNamesValidation = false

timeline {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_timeline_${params.trace_report_suffix}.html"
}
report {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_report_${params.trace_report_suffix}.html"
}
trace {
    enabled = true
    file    = "${params.outdir}/pipeline_info/execution_trace_${params.trace_report_suffix}.txt"
}
dag {
    enabled = true
    file    = "${params.outdir}/pipeline_info/pipeline_dag_${params.trace_report_suffix}.html"
}

manifest {
    name            = 'VIBTOBIlab/scalemethyltobi'
    contributors    = [
        [
            name: 'ScaleBio',
            affiliation: '',
            email: '',
            github: '',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'VIBTOBIlab',
            affiliation: '',
            email: '',
            github: '',
            contribution: ['author'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
        [
            name: 'Edoardo Giuili',
            affiliation: '',
            email: '',
            github: 'edogiuili',
            contribution: ['contributor'], // List of contribution types ('author', 'maintainer' or 'contributor')
            orcid: ''
        ],
    ]
    homePage        = 'https://github.com/VIBTOBIlab/ScaleMethylTOBI'
    description     = """ScaleBio single-cell DNA methylation analysis workflow"""
    mainScript      = 'main.nf'
    defaultBranch   = 'main'
    nextflowVersion = '!>=26.04.0'
    version         = '1.6.0'
    doi             = ''
    diagram         = 'docs/images/metro_map.svg'
}

// Nextflow plugins
plugins {
    id 'nf-schema@2.7.3' // Validation of pipeline parameters and creation of an input channel from a sample sheet
}

validation {
    defaultIgnoreParams = ["genomes"].toSet()
    monochromeLogs = params.monochrome_logs
}
// Load modules.config for DSL2 module specific options
includeConfig 'conf/modules.config'
